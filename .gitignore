# ==============================================================================
# SwiftTransit - Git Ignore Configuration
# ==============================================================================

# Compiled Java bytecode
*.class

# Mobile / Package Tools
*.war
*.ear
*.nar

# Virtual Machine Crash Logs
hs_err_pid*
replay_pid*

# Package Archives / Build Output
bin/
out/
build/
target/
dist/

# SQLite Temporary and Journal Files
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Runtime Generated Database & Legacy Data
# (Uncomment the line below if you do not want to track your local runtime database)
# bus_reservation.db
# tickets.txt

# Downloaded Library JARs (auto-fetched by run.bat)
# *.jar

# IDE & Editor Configurations
# VS Code
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
.metadata/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# OS-generated files
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Logs & Temporary Files
*.log
*.tmp
*.bak
*~
